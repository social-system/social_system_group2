# ===== 必須 =====

# OpenAI API キー
# https://platform.openai.com/api-keys から取得
OPENAI_API_KEY=<ここにAPIキーを入力，実際のキーは入力しないこと>

# 冷蔵庫在庫管理システムのベースURL
FRIDGE_API_BASE_URL=http://localhost:9090

# ===== 任意 =====

# HTTPサーバーのポート番号 (デフォルト: 8080)
PORT=8080

# ユーザー設定の保存ファイルパス (デフォルト: ./data/preferences.json)
USER_PREFS_FILE_PATH=./data/preferences.json

# 使用するOpenAIモデル (デフォルト: gpt-5.4-nano)
OPENAI_MODEL=gpt-5.4-nano

# AIレスポンスのインメモリキャッシュ有効化 (デフォルト: true)
AI_CACHE_ENABLED=true

# デバッグモード: true かつ OPENAI_API_KEY 未設定の場合はスタブAIを使用 (デフォルト: false)
DEBUG=false
